locale/translations_pot_files=PackedStringArray("res://scenes/ui/menus/settings_menu.tscn", "res://scenes/ui/aquarium/aquarium_card.tscn", "res://scenes/ui/aquarium/aquarium_selector.tscn", "res://game/ui/aquarium/aquarium_selector.gd", "res://localization/extra_strings.gd")

[layer_names]

